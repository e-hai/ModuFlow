{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_09.schema.json",
  "title": "Stage 09 Release & Gate G4 Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "release"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["09"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "release": {
      "type": "object",
      "required": ["store_targets", "compliance_checked", "has_remote_killswitch", "rollback_plan"],
      "properties": {
        "store_targets": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "compliance_checked": { "type": "boolean", "const": true },
        "has_remote_killswitch": { "type": "boolean", "const": true },
        "rollback_plan": { "type": "string", "minLength": 10 }
      },
      "additionalProperties": false
    }
  }
}
