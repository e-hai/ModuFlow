{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_06.schema.json",
  "title": "Stage 06 UX & UI Design Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "design"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["06"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "design": {
      "type": "object",
      "required": ["platform", "safe_area", "touch_targets"],
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["cross_platform", "ios", "android"]
        },
        "safe_area": {
          "type": "object",
          "properties": {
            "top_safe_padding_pt": { "type": "number", "minimum": 0 },
            "bottom_safe_padding_pt": { "type": "number", "minimum": 0 },
            "status_bar_safe_dp": { "type": "number", "minimum": 0 }
          }
        },
        "touch_targets": {
          "type": "object",
          "properties": {
            "min_touch_target_pt": { "type": "number", "minimum": 0 },
            "min_touch_target_dp": { "type": "number", "minimum": 0 }
          }
        },
        "tokens_defined": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
