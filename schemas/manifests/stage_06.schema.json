{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_06.schema.json",
  "title": "Stage 07 Engineering Architecture Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "engineering"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["06"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "engineering": {
      "type": "object",
      "required": ["coverage_percent", "zero_client_inference"],
      "properties": {
        "coverage_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "zero_client_inference": { "type": "boolean" },
        "modules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "app": {
          "type": "string",
          "minLength": 1,
          "description": "应用入口，定义 run(ac) 并返回跑完后的页面 id"
        },
        "packages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "test": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": { "path": { "type": "string", "minLength": 1 } }
            },
            "release": {
              "type": "object",
              "required": ["path"],
              "additionalProperties": false,
              "properties": { "path": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["view_id", "path"],
            "additionalProperties": false,
            "properties": {
              "view_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
              "path": { "type": "string", "minLength": 1 }
            }
          }
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ac", "path", "command"],
            "properties": {
              "ac": { "type": "string", "pattern": "^AC-\\d{2}$" },
              "path": { "type": "string", "minLength": 1 },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
