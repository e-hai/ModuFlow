{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_03.schema.json",
  "title": "Stage 03 Product Direction Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "direction"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["03"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "direction": {
      "type": "object",
      "required": ["uvp", "moscow", "hypotheses"],
      "properties": {
        "uvp": { "type": "string", "minLength": 5 },
        "target_audience": { "type": "string" },
        "moscow": {
          "type": "object",
          "required": ["must"],
          "properties": {
            "must": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "should": { "type": "array", "items": { "type": "string" } },
            "could": { "type": "array", "items": { "type": "string" } },
            "wont": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "hypothesis"],
            "properties": {
              "id": { "type": "string" },
              "hypothesis": { "type": "string" },
              "validation_stage": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
