{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_11.schema.json",
  "title": "Stage 11 Retention & Continuous Iteration Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "retention"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["11"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "retention": {
      "type": "object",
      "required": ["d1_retention", "d7_retention", "d30_retention", "backlog_items"],
      "properties": {
        "d1_retention": { "type": "number", "minimum": 0, "maximum": 100 },
        "d7_retention": { "type": "number", "minimum": 0, "maximum": 100 },
        "d30_retention": { "type": "number", "minimum": 0, "maximum": 100 },
        "backlog_items": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
