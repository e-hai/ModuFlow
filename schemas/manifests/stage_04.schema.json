{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_04.schema.json",
  "title": "Stage 04 PRD Specification Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "views",
    "acceptance_criteria",
    "event_dictionary",
    "compliance"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["04"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,31}$",
            "description": "页面的唯一名字，用来命名 screens/{id}.html，也用于跳转"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "给人看的解释，不参与文件名和跳转"
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "view_id", "given", "when", "then"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^AC-\\d{2}$" },
          "view_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
          "given": { "type": "string", "minLength": 1 },
          "when": { "type": "string", "minLength": 1 },
          "then": { "type": "string", "minLength": 1 }
        }
      }
    },
    "event_dictionary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "trigger": { "type": "string" }
        }
      }
    },
    "compliance": {
      "type": "object",
      "required": ["uses_idfa", "uses_ad_id"],
      "properties": {
        "uses_idfa": { "type": "boolean" },
        "att_copy": { "type": "string" },
        "att_denied_fallback": { "type": "string" },
        "uses_ad_id": { "type": "boolean" },
        "ad_id_permission_declared": { "type": "boolean" },
        "min_audience_age": { "type": "integer", "minimum": 13 },
        "ad_id_opt_out_fallback": { "type": "string" }
      }
    }
  }
}
