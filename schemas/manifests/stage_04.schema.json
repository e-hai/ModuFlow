{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_04.schema.json",
  "title": "Stage 04 Fake Door Validation Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "fakedoor"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["04"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "fakedoor": {
      "type": "object",
      "required": ["entry", "interactive", "measured_results"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "interactive": { "type": "boolean", "const": true },
        "test_budget_usd": { "type": "number", "minimum": 0 },
        "measured_results": {
          "oneOf": [
            { "type": "string", "enum": ["pending"] },
            {
              "type": "object",
              "required": ["status", "source"],
              "properties": {
                "status": { "type": "string", "enum": ["measured"] },
                "source": { "type": "string", "minLength": 1 },
                "ctr": { "type": "number" },
                "leads": { "type": "integer" }
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
