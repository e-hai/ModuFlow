{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/manifests/stage_10.schema.json",
  "title": "Stage 10 User Acquisition Manifest",
  "type": "object",
  "required": [
    "contract_version",
    "stage",
    "artifacts",
    "risk_flags",
    "acquisition"
  ],
  "properties": {
    "contract_version": { "type": "string", "enum": ["1"] },
    "stage": { "type": "string", "enum": ["10"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "risk_flags": { "type": "object" },
    "acquisition": {
      "type": "object",
      "required": ["ecac_usd", "ecac_limit_usd", "channels", "daily_budget_usd"],
      "properties": {
        "ecac_usd": { "type": "number", "minimum": 0 },
        "ecac_limit_usd": { "type": "number", "minimum": 0 },
        "channels": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "daily_budget_usd": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
