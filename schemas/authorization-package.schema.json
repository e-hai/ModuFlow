{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moduflow.ai/schemas/authorization-package.schema.json",
  "title": "ModuFlow Product Authorization Package",
  "description": "JSON Schema specification for ModuFlow product-level authorization packages (authorization.yaml)",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "project_name",
    "owner",
    "authorized_at",
    "time_budget",
    "financial_budget",
    "kill_criteria",
    "lead_forbidden",
    "credential_scopes",
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0", "1.0.0"],
      "description": "Version of the authorization package schema"
    },
    "project_id": {
      "type": "string",
      "minLength": 2,
      "description": "Unique project identifier or code (e.g. WN-PAGER)"
    },
    "project_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable name of the product"
    },
    "owner": {
      "type": "object",
      "required": ["name", "role", "email"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human sponsor or decision maker's name"
        },
        "role": {
          "type": "string",
          "enum": ["human_sponsor", "executive_lead", "portfolio_owner"],
          "description": "Role of the human authorizer"
        },
        "email": {
          "type": "string",
          "description": "Email address for red-gate escalation notifications"
        }
      }
    },
    "authorized_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of human authorization"
    },
    "time_budget": {
      "type": "object",
      "required": ["start_date", "deadline", "max_duration_days"],
      "additionalProperties": false,
      "properties": {
        "start_date": {
          "type": "string",
          "description": "ISO 8601 date string for iteration start"
        },
        "deadline": {
          "type": "string",
          "description": "ISO 8601 date string for final deadline"
        },
        "max_duration_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum calendar days allowed before hard stop"
        }
      }
    },
    "financial_budget": {
      "type": "object",
      "required": ["currency", "total_budget_limit", "hard_stop_limit"],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "default": "USD",
          "description": "Three-letter currency code"
        },
        "total_budget_limit": {
          "type": "number",
          "minimum": 0,
          "description": "Total funding budget allocated by human sponsor"
        },
        "hard_stop_limit": {
          "type": "number",
          "minimum": 0,
          "description": "Hard-stop funding ceiling; exceeds trigger immediate circuit-break"
        },
        "per_stage_limits": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          },
          "description": "Budget limits per stage code (e.g., '01': 200, '04': 350, '10': 1000)"
        }
      }
    },
    "kill_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Deterministic stop-loss conditions evaluated without LLM",
      "items": {
        "type": "object",
        "required": ["id", "metric", "operator", "threshold", "action"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^KC-[0-9]{2,}$",
            "description": "Unique identifier for the kill criterion (e.g. KC-01)"
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "description": "Metric name (e.g. cac, ltv_cac_ratio, d1_retention, payback_months, som_annual, ad_ctr)"
          },
          "operator": {
            "type": "string",
            "enum": [">", "<", ">=", "<=", "==", "!="],
            "description": "Comparison operator"
          },
          "threshold": {
            "type": "number",
            "description": "Numerical cutoff threshold"
          },
          "action": {
            "type": "string",
            "enum": ["pause_and_escalate", "terminate_project"],
            "description": "Automatic action taken when condition is met"
          },
          "description": {
            "type": "string",
            "description": "Human-readable explanation of the stop-loss rule"
          }
        }
      }
    },
    "lead_forbidden": {
      "type": "array",
      "minItems": 1,
      "description": "List of actions strictly forbidden for the lead agent",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "credential_scopes": {
      "type": "object",
      "required": ["allowed_agent_credentials", "forbidden_agent_credentials"],
      "additionalProperties": false,
      "properties": {
        "allowed_agent_credentials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "API credentials explicitly granted to agents"
        },
        "forbidden_agent_credentials": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Credentials strictly held by humans only (store accounts, live payment keys, prod DB)"
        }
      }
    },
    "profile": {
      "type": "object",
      "required": ["platform"],
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": ["ios", "android", "web", "cross_platform"],
          "description": "Target client operating system / platform"
        },
        "client_zero_inference": {
          "type": "boolean",
          "default": true,
          "description": "Whether client-side zero inference cost is strictly enforced"
        },
        "architecture_strategy": {
          "type": "string",
          "enum": ["kmp_cmp", "dual_native"],
          "default": "kmp_cmp",
          "description": "Mobile engineering architecture strategy (kmp_cmp or dual_native)"
        }
      }
    }
  }
}
