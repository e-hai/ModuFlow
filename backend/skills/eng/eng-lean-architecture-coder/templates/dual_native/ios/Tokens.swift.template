import SwiftUI

/**
 * ModuFlow Canonical iOS Design Tokens
 * Single Source of Truth directly derived from Stage 06 tokens.json.
 */
public enum MfTokens {
    public enum Colors {
        public static let primary = Color(hex: "#0E8A5A")
        public static let primaryDark = Color(hex: "#0A6B46")
        public static let primarySoft = Color(hex: "#E3F4EC")
        public static let background = Color(hex: "#F8FAFC")
        public static let surface = Color(hex: "#FFFFFF")
        public static let text = Color(hex: "#0F172A")
        public static let textMuted = Color(hex: "#64748B")
        public static let border = Color(hex: "#E2E8F0")
        public static let danger = Color(hex: "#DC2626")
    }

    public enum Metrics {
        public static let minTouchTarget: CGFloat = 44.0 // Apple HIG minimum
        public static let radiusCard: CGFloat = 12.0
        public static let radiusBtn: CGFloat = 12.0
        public static let safeTopDynamicIsland: CGFloat = 74.0
        public static let safeBottomHomeIndicator: CGFloat = 34.0
    }
}

public extension Color {
    init(hex: String) {
        let hex = hex.trimmingCharacters(in: CharacterSet.alphanumerics.inverted)
        var int: UInt64 = 0
        Scanner(string: hex).scanHexInt64(&int)
        let a, r, g, b: UInt64
        switch hex.count {
        case 6: // RGB (24-bit)
            (a, r, g, b) = (255, int >> 16, int >> 8 & 0xFF, int & 0xFF)
        case 8: // ARGB (32-bit)
            (a, r, g, b) = (int >> 24, int >> 16 & 0xFF, int >> 8 & 0xFF, int & 0xFF)
        default:
            (a, r, g, b) = (255, 0, 0, 0)
        }
        self.init(
            .sRGB,
            red: Double(r) / 255,
            green: Double(g) / 255,
            blue: Double(b) / 255,
            opacity: Double(a) / 255
        )
    }
}
