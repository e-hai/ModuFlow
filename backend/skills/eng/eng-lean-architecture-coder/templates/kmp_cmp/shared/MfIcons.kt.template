                // Speaker body
                moveTo(11f, 5f)
                lineTo(6f, 9f)
                lineTo(2f, 9f)
                lineTo(2f, 15f)
                lineTo(6f, 15f)
                lineTo(11f, 19f)
                close()
                // Sound wave arc
                moveTo(15.54f, 8.46f)
                arcTo(5f, 5f, 0f, isMoreThanHalf = false, isPositiveArc = true, 15.54f, 15.54f)
                // Outer wave arc
                moveTo(19.07f, 4.93f)
                arcTo(10f, 10f, 0f, isMoreThanHalf = false, isPositiveArc = true, 19.07f, 19.07f)
            }
        }.build()
    }

